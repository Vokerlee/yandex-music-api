@PACKAGE_INIT@
if(NOT @BUILD_SHARED_LIBS@)
    include(CMakeFindDependencyMacro)
    find_dependency(CURL 8.5)
    if(NOT WIN32)
        find_dependency(OpenSSL COMPONENTS Crypto)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/yandex_musicTargets.cmake")
check_required_components(yandex_music)
